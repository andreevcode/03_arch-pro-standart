@startuml
title "MVP передачи ставок в call-центры банка Стандарт. Container Diagram"

top to bottom direction

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
Boundary(ext_office, "Ext Office", "") {
    System_Ext(partner_call_centre, "Partner call-центр", "партнерская система call-центра")
    Person_Ext(partner_call_operator, "Partner call-operator", "уточняет заявку и согласовывает посещение офиса")
}

Boundary(back_office, "Back Office", "") {
    System(call_centre, "Call-центр", "Cистема call-центра")
    Person(call_operator, "Call-operator", "уточняет заявку и согласовывает посещение офиса")

    Person(back_credit_manager, "Back credit manager", "рассчитывает ежедневные ставки депозитов")

    Boundary(abs, "ABS", "System") {
         Container(abs_sftp_adapter, "ABS SFTP adapter", "Java, Spring", "Адаптер для обмена SFTP")
         Container(abs_client, "ABS client", Delphi, "десктоп-клиент к АБС")
         ContainerDb(abs_db, "ABS DB", Oracle, "база данных АБС")
         Container(deposit_rates_manager, "NEW\nDeposit rates manager", "Java, Spring", "Отвечает за обновление ставок за пределами АБС")
         ContainerQueue(deposit_rates_queue, "NEW\nDeposit rates queue", "Kafka", "Очередь депозитных ставок")
    }
}

Rel(call_operator, call_centre,"видит актуальные ставки")
Rel(partner_call_operator, partner_call_centre,"просматривает файлы с изменениями ставок")

Rel(call_centre, deposit_rates_queue,"REST\n актуальные ставки")
Rel(deposit_rates_manager, abs_sftp_adapter," актуальные ставки")
Rel(deposit_rates_manager, deposit_rates_queue, " ")

BiRel(deposit_rates_manager, abs_db, " pl/sql ")

BiRel(abs_client, abs_db," pl/sql ")

Rel(back_credit_manager, abs_client,"расчет ставок депозитов")

Rel(abs_sftp_adapter, partner_call_centre,"SFTP\n актуальные ставки")

'Lay_L(abs_client, back_credit_manager)
'Lay_R(partner_call_centre, abs_sftp_adapter)

@enduml